import { CyberTheme } from "../theme.slint";
import { CyberButton } from "../components/button.slint";
import {
    IconWave,
    IconNote,
    IconArtist,
    IconGenre,
    IconPlus,
    IconClose,
    IconCheck,
    IconChevronRight
} from "../components/icons.slint";

export struct PlaylistRow {
    id: int,
    name: string,
    track_count: int,
}

export component LibrarySidebar inherits Rectangle {
    in property <[PlaylistRow]> playlists: [];
    in-out property <int> selected_nav: 0; // 0: All Tracks, 1: Artists, 2: Genres
    in-out property <int> selected_playlist_id: -1;
    in-out property <bool> is_my_wave_active: false;
    in-out property <bool> is_creating_playlist: false;
    in-out property <string> new_playlist_name: "";

    callback nav_selected(int);
    callback playlist_selected(int, string);
    callback playlist_deleted(int, string);
    callback create_playlist(string);
    callback my_wave_toggled();

    width: 230px;
    background: #080B10;
    border-width: 1px;
    border-color: CyberTheme.border;

    VerticalLayout {
        padding: 12px;
        spacing: 14px;

        // Tactical telemetry header with ONLINE green status dot
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "SYS_BUS // 0xNODE";
                font-family: CyberTheme.font_mono;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 0.5px;
                color: CyberTheme.muted;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 5px;
                alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: CyberTheme.cyber_green;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "ONLINE";
                    font-family: CyberTheme.font_mono;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    color: CyberTheme.cyber_green;
                    vertical-alignment: center;
                }
            }
        }

        // ================= NEURAL WAVE (MY WAVE) =================
        my_wave_box := Rectangle {
            height: 42px;
            background: root.is_my_wave_active ? #00F0FF14 : CyberTheme.surface;
            border-width: 1px;
            border-color: root.is_my_wave_active ? CyberTheme.cyber_cyan : (wave_touch.has-hover ? CyberTheme.accent : CyberTheme.border);
            border-radius: CyberTheme.radius_sm;

            // 45-degree chamfer corner notch
            Path {
                x: parent.width - 6px;
                y: 0px;
                width: 6px;
                height: 6px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 6;
                viewbox-height: 6;
                fill: root.is_my_wave_active ? CyberTheme.cyber_cyan : CyberTheme.border;
                commands: "M 0 0 L 6 0 L 6 6 Z";
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    IconWave {
                        size: 16px;
                        icon_color: root.is_my_wave_active ? CyberTheme.cyber_cyan : (wave_touch.has-hover ? CyberTheme.accent : CyberTheme.muted);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.is_my_wave_active ? "MY WAVE // LIVE" : "MY WAVE";
                        font-family: CyberTheme.font_mono;
                        font-size: 11px;
                        font-weight: 700;
                        color: root.is_my_wave_active ? CyberTheme.cyber_cyan : (wave_touch.has-hover ? #FFFFFF : CyberTheme.text);
                        vertical-alignment: center;
                    }
                }

                // Active Status Badge
                Rectangle {
                    height: 18px;
                    background: root.is_my_wave_active ? #00F0FF26 : #111622;
                    border-width: 1px;
                    border-color: root.is_my_wave_active ? CyberTheme.cyber_cyan : CyberTheme.border;
                    border-radius: 2px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.is_my_wave_active ? "ACTIVE" : "OFF";
                            font-family: CyberTheme.font_mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.is_my_wave_active ? CyberTheme.cyber_cyan : CyberTheme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            wave_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is_my_wave_active = !root.is_my_wave_active;
                    root.my_wave_toggled();
                }
            }
        }

        // ================= REPOSITORY NAVIGATION SECTION =================
        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                padding-bottom: 2px;
                Text {
                    text: "// REPOSITORY";
                    font-family: CyberTheme.font_mono;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    color: CyberTheme.muted;
                }
            }

            // All Tracks Item
            all_btn := Rectangle {
                height: 32px;
                background: (root.selected_nav == 0 && root.selected_playlist_id == -1) ? CyberTheme.active_row :
                            (all_touch.has-hover ? #121824 : transparent);
                border-width: 1px;
                border-color: (root.selected_nav == 0 && root.selected_playlist_id == -1) ? CyberTheme.accent : transparent;
                border-radius: CyberTheme.radius_sm;

                // Left glowing indicator line
                if (root.selected_nav == 0 && root.selected_playlist_id == -1) : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 2px;
                    height: parent.height;
                    background: CyberTheme.accent;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    IconNote {
                        size: 14px;
                        icon_color: (root.selected_nav == 0 && root.selected_playlist_id == -1) ? CyberTheme.accent : CyberTheme.muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "All Tracks";
                        font-family: CyberTheme.font_mono;
                        font-size: 12px;
                        font-weight: (root.selected_nav == 0 && root.selected_playlist_id == -1) ? 700 : 500;
                        color: (root.selected_nav == 0 && root.selected_playlist_id == -1) ? CyberTheme.accent : (all_touch.has-hover ? #FFFFFF : CyberTheme.text);
                        vertical-alignment: center;
                    }
                }

                all_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_nav = 0;
                        root.selected_playlist_id = -1;
                        root.nav_selected(0);
                    }
                }
            }

            // Artists Item
            artists_btn := Rectangle {
                height: 32px;
                background: (root.selected_nav == 1 && root.selected_playlist_id == -1) ? CyberTheme.active_row :
                            (art_touch.has-hover ? #121824 : transparent);
                border-width: 1px;
                border-color: (root.selected_nav == 1 && root.selected_playlist_id == -1) ? CyberTheme.accent : transparent;
                border-radius: CyberTheme.radius_sm;

                // Left glowing indicator line
                if (root.selected_nav == 1 && root.selected_playlist_id == -1) : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 2px;
                    height: parent.height;
                    background: CyberTheme.accent;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    IconArtist {
                        size: 14px;
                        icon_color: (root.selected_nav == 1 && root.selected_playlist_id == -1) ? CyberTheme.accent : CyberTheme.muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Artists";
                        font-family: CyberTheme.font_mono;
                        font-size: 12px;
                        font-weight: (root.selected_nav == 1 && root.selected_playlist_id == -1) ? 700 : 500;
                        color: (root.selected_nav == 1 && root.selected_playlist_id == -1) ? CyberTheme.accent : (art_touch.has-hover ? #FFFFFF : CyberTheme.text);
                        vertical-alignment: center;
                    }
                }

                art_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_nav = 1;
                        root.selected_playlist_id = -1;
                        root.nav_selected(1);
                    }
                }
            }

            // Genres Item
            genres_btn := Rectangle {
                height: 32px;
                background: (root.selected_nav == 2 && root.selected_playlist_id == -1) ? CyberTheme.active_row :
                            (gen_touch.has-hover ? #121824 : transparent);
                border-width: 1px;
                border-color: (root.selected_nav == 2 && root.selected_playlist_id == -1) ? CyberTheme.accent : transparent;
                border-radius: CyberTheme.radius_sm;

                // Left glowing indicator line
                if (root.selected_nav == 2 && root.selected_playlist_id == -1) : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 2px;
                    height: parent.height;
                    background: CyberTheme.accent;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    IconGenre {
                        size: 14px;
                        icon_color: (root.selected_nav == 2 && root.selected_playlist_id == -1) ? CyberTheme.accent : CyberTheme.muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Genres";
                        font-family: CyberTheme.font_mono;
                        font-size: 12px;
                        font-weight: (root.selected_nav == 2 && root.selected_playlist_id == -1) ? 700 : 500;
                        color: (root.selected_nav == 2 && root.selected_playlist_id == -1) ? CyberTheme.accent : (gen_touch.has-hover ? #FFFFFF : CyberTheme.text);
                        vertical-alignment: center;
                    }
                }

                gen_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected_nav = 2;
                        root.selected_playlist_id = -1;
                        root.nav_selected(2);
                    }
                }
            }
        }

        // ================= PLAYLISTS SECTION =================
        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            // Section Header & "+ NEW PLAYLIST" cyber button
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "// PLAYLISTS";
                    font-family: CyberTheme.font_mono;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    color: CyberTheme.muted;
                    vertical-alignment: center;
                }

                CyberButton {
                    compact: true;
                    active: root.is_creating_playlist;
                    clicked => {
                        root.is_creating_playlist = !root.is_creating_playlist;
                    }

                    IconPlus {
                        size: 11px;
                        icon_color: parent.icon_color;
                    }

                    text: "NEW PLAYLIST";
                }
            }

            // Create Playlist Input Row
            if (root.is_creating_playlist) : Rectangle {
                height: 34px;
                background: CyberTheme.surface;
                border-width: 1px;
                border-color: CyberTheme.accent;
                border-radius: CyberTheme.radius_sm;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 6px;

                    input := TextInput {
                        text <=> root.new_playlist_name;
                        font-family: CyberTheme.font_mono;
                        font-size: 11px;
                        color: CyberTheme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accepted => {
                            if (root.new_playlist_name != "") {
                                root.create_playlist(root.new_playlist_name);
                                root.new_playlist_name = "";
                                root.is_creating_playlist = false;
                            }
                        }
                    }

                    // Submit Button with IconCheck
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: submit_touch.has-hover ? CyberTheme.accent : #141A26;
                        border-width: 1px;
                        border-color: submit_touch.has-hover ? CyberTheme.accent : CyberTheme.border;
                        border-radius: 1px;
                        y: (parent.height - self.height) / 2;

                        IconCheck {
                            size: 12px;
                            icon_color: submit_touch.has-hover ? CyberTheme.accent_text : CyberTheme.accent;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        submit_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.new_playlist_name != "") {
                                    root.create_playlist(root.new_playlist_name);
                                    root.new_playlist_name = "";
                                    root.is_creating_playlist = false;
                                }
                            }
                        }
                    }

                    // Cancel Button with IconClose
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: cancel_touch.has-hover ? CyberTheme.cyber_crimson : #141A26;
                        border-width: 1px;
                        border-color: cancel_touch.has-hover ? CyberTheme.cyber_crimson : CyberTheme.border;
                        border-radius: 1px;
                        y: (parent.height - self.height) / 2;

                        IconClose {
                            size: 11px;
                            icon_color: cancel_touch.has-hover ? #FFFFFF : CyberTheme.muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        cancel_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.new_playlist_name = "";
                                root.is_creating_playlist = false;
                            }
                        }
                    }
                }
            }

            // Playlists List with numbered prefixes (01, 02...)
            VerticalLayout {
                spacing: 3px;

                for pl[idx] in root.playlists : Rectangle {
                    height: 32px;
                    background: (root.selected_playlist_id == pl.id) ? CyberTheme.active_row :
                                (pl_touch.has-hover ? #121824 : transparent);
                    border-width: 1px;
                    border-color: (root.selected_playlist_id == pl.id) ? CyberTheme.accent : transparent;
                    border-radius: CyberTheme.radius_sm;

                    // Active left glowing accent bar
                    if (root.selected_playlist_id == pl.id) : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 2px;
                        height: parent.height;
                        background: CyberTheme.accent;
                    }

                    // Background Click Area
                    pl_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected_playlist_id = pl.id;
                            root.playlist_selected(pl.id, pl.name);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            horizontal-stretch: 1;

                            // Numbered Index Badge (01, 02, etc.)
                            Text {
                                text: (idx < 9 ? "0" : "") + (idx + 1);
                                font-family: CyberTheme.font_mono;
                                font-size: 10px;
                                font-weight: 700;
                                color: (root.selected_playlist_id == pl.id) ? CyberTheme.accent : CyberTheme.muted;
                                vertical-alignment: center;
                            }

                            Text {
                                text: pl.name;
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                font-weight: (root.selected_playlist_id == pl.id) ? 700 : 500;
                                color: (root.selected_playlist_id == pl.id) ? CyberTheme.accent : (pl_touch.has-hover ? #FFFFFF : CyberTheme.text);
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        // Track Count Badge
                        Rectangle {
                            height: 18px;
                            background: (root.selected_playlist_id == pl.id) ? #FCEE0A22 : #111622;
                            border-width: 1px;
                            border-color: (root.selected_playlist_id == pl.id) ? CyberTheme.accent : CyberTheme.border;
                            border-radius: 2px;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: pl.track_count + " TRK";
                                    font-family: CyberTheme.font_mono;
                                    font-size: 9px;
                                    font-weight: 600;
                                    color: (root.selected_playlist_id == pl.id) ? CyberTheme.accent : CyberTheme.muted;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Delete button with IconClose
                        del_btn := Rectangle {
                            width: 20px;
                            height: 20px;
                            background: del_touch.has-hover ? CyberTheme.cyber_crimson : transparent;
                            border-width: 1px;
                            border-color: del_touch.has-hover ? CyberTheme.cyber_crimson : transparent;
                            border-radius: 1px;
                            y: (parent.height - self.height) / 2;

                            IconClose {
                                size: 10px;
                                icon_color: del_touch.has-hover ? #FFFFFF : CyberTheme.muted;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            del_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.playlist_deleted(pl.id, pl.name);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
