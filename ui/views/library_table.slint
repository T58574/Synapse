import { CyberTheme } from "../theme.slint";
import { CyberButton } from "../components/button.slint";
import { ListView } from "std-widgets.slint";
import { PlaylistRow } from "./sidebar.slint";
import {
    IconPlay,
    IconSearch,
    IconClose,
    IconFolder,
    IconPlus,
    IconCheck,
    IconNote
} from "../components/icons.slint";

export struct TrackRow {
    file_path: string,
    title: string,
    artist: string,
    bpm: float,
    key_sig: string,
    duration: string,
    is_playing: bool,
}

export component LibraryTable inherits Rectangle {
    in property <[TrackRow]> tracks: [];
    in property <[PlaylistRow]> playlists: [];
    in-out property <string> search_query: "";
    in property <int> active_index: -1;
    in property <int> selected_playlist_id: -1;
    in-out property <int> popup_track_idx: -1;
    in-out property <string> popup_track_path: "";

    callback track_clicked(int, string);
    callback search_changed(string);
    callback add_to_playlist_clicked(int, string);
    callback remove_track_clicked(int, string);
    callback add_to_queue_clicked(int, string);
    callback edit_track_clicked(int, string);
    callback open_music_dir();

    background: #08090D;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // ================= SEARCH & TOP TOOLBAR =================
        HorizontalLayout {
            height: 36px;
            spacing: 12px;
            alignment: space-between;
            cross-axis-alignment: center;

            // Search Bar Input with Tactical Prompt
            search_box := Rectangle {
                horizontal-stretch: 1;
                min-width: 240px;
                background: CyberTheme.surface;
                border-width: 1px;
                border-color: search_input.has-focus ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;
                clip: true;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Rectangle {
                        width: 16px;
                        IconSearch {
                            size: 14px;
                            icon_color: search_input.has-focus ? CyberTheme.accent : CyberTheme.muted;
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if (search_input.text == "") : Text {
                            width: 100%;
                            height: 100%;
                            text: "Search tracks by title, artist, key, bpm...";
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: CyberTheme.muted;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }

                        search_input := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.search_query;
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: CyberTheme.text;
                            vertical-alignment: center;
                            edited => {
                                root.search_changed(self.text);
                            }
                        }
                    }

                    if (root.search_query != "") : Rectangle {
                        width: 20px;
                        height: 20px;
                        background: clear_touch.has-hover ? CyberTheme.cyber_crimson : transparent;
                        border-radius: 1px;
                        y: (parent.height - self.height) / 2;

                        IconClose {
                            size: 10px;
                            icon_color: clear_touch.has-hover ? #FFFFFF : CyberTheme.muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        clear_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.search_query = "";
                                root.search_changed("");
                            }
                        }
                    }
                }
            }

            CyberButton {
                clicked => { root.open_music_dir(); }
                IconFolder {
                    size: 13px;
                    icon_color: parent.icon_color;
                }
                text: "OPEN DIRECTORY";
            }
        }

        // ================= TABLE HEADER =================
        if (root.tracks.length > 0) : VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            Rectangle {
                height: 30px;
                background: #0B0E16;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: CyberTheme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "#";
                        width: 36px;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "TRACK TITLE";
                        horizontal-stretch: 3;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "ARTIST";
                        horizontal-stretch: 2;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    Text {
                        text: "BPM";
                        width: 54px;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "KEY";
                        width: 54px;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "DURATION";
                        width: 64px;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "ACTIONS";
                        width: 90px;
                        font-family: CyberTheme.font_mono;
                        font-size: 9px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            // Virtualized ListView
            ListView {
                vertical-stretch: 1;

                for track[idx] in root.tracks : Rectangle {
                    height: 38px;
                    background: track.is_playing ? CyberTheme.active_row :
                                (row_touch.has-hover ? #121724 : (Math.mod(idx, 2) == 0 ? #090B10 : #06080C));

                    // Left neon border
                    if (track.is_playing || root.active_index == idx) : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 3px;
                        height: parent.height;
                        background: track.is_playing ? CyberTheme.cyber_green : CyberTheme.accent;
                    }

                    // Bottom subtle line
                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: #0E131E;
                    }

                    // Background clickable touch
                    row_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.track_clicked(idx, track.file_path);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        // # or Playing Icon
                        Rectangle {
                            width: 36px;
                            HorizontalLayout {
                                alignment: center;
                                if (track.is_playing) : IconPlay {
                                    size: 11px;
                                    icon_color: CyberTheme.cyber_green;
                                    y: (parent.height - self.height) / 2;
                                }
                                if (!track.is_playing) : Text {
                                    text: (idx + 1);
                                    font-family: CyberTheme.font_mono;
                                    font-size: 10px;
                                    font-weight: 500;
                                    color: CyberTheme.muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Track Title
                        Text {
                            text: track.title;
                            horizontal-stretch: 3;
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            font-weight: track.is_playing ? 700 : 500;
                            color: track.is_playing ? CyberTheme.accent : (row_touch.has-hover ? #FFFFFF : CyberTheme.text);
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        // Artist (Left-aligned for clean readability)
                        Text {
                            text: track.artist;
                            horizontal-stretch: 2;
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: track.is_playing ? CyberTheme.accent : CyberTheme.muted;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }

                        // BPM
                        Text {
                            text: Math.round(track.bpm);
                            width: 54px;
                            font-family: CyberTheme.font_mono;
                            font-size: 10px;
                            color: CyberTheme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        // Camelot Key Badge
                        Rectangle {
                            width: 54px;
                            HorizontalLayout {
                                alignment: center;
                                key_badge := Rectangle {
                                    property <color> badge_bg: (track.key_sig == "8A" || track.key_sig == "8B" || track.key_sig == "7A" || track.key_sig == "7B" || track.key_sig == "9A" || track.key_sig == "9B") ? #00FF661A :
                                                               (track.key_sig == "4A" || track.key_sig == "4B" || track.key_sig == "5A" || track.key_sig == "5B" || track.key_sig == "6A" || track.key_sig == "6B") ? #FF99001A :
                                                               (track.key_sig == "" || track.key_sig == "--") ? #18202E : #00F0FF1A;
                                    property <color> badge_border: (track.key_sig == "8A" || track.key_sig == "8B" || track.key_sig == "7A" || track.key_sig == "7B" || track.key_sig == "9A" || track.key_sig == "9B") ? #00FF6655 :
                                                                   (track.key_sig == "4A" || track.key_sig == "4B" || track.key_sig == "5A" || track.key_sig == "5B" || track.key_sig == "6A" || track.key_sig == "6B") ? #FF990055 :
                                                                   (track.key_sig == "" || track.key_sig == "--") ? CyberTheme.border : #00F0FF55;
                                    property <color> badge_fg: (track.key_sig == "8A" || track.key_sig == "8B" || track.key_sig == "7A" || track.key_sig == "7B" || track.key_sig == "9A" || track.key_sig == "9B") ? CyberTheme.cyber_green :
                                                               (track.key_sig == "4A" || track.key_sig == "4B" || track.key_sig == "5A" || track.key_sig == "5B" || track.key_sig == "6A" || track.key_sig == "6B") ? CyberTheme.cyber_amber :
                                                               (track.key_sig == "" || track.key_sig == "--") ? CyberTheme.muted : CyberTheme.cyber_cyan;

                                    height: 18px;
                                    background: self.badge_bg;
                                    border-width: 1px;
                                    border-color: self.badge_border;
                                    border-radius: 2px;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: track.key_sig != "" ? track.key_sig : "--";
                                            font-family: CyberTheme.font_mono;
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: key_badge.badge_fg;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Duration
                        Text {
                            text: track.duration;
                            width: 64px;
                            font-family: CyberTheme.font_mono;
                            font-size: 10px;
                            color: CyberTheme.muted;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        // Actions Row (Hover-revealed)
                        HorizontalLayout {
                            width: 90px;
                            spacing: 4px;
                            alignment: center;
                            opacity: (row_touch.has-hover || track.is_playing || root.popup_track_idx == idx) ? 1.0 : 0.2;
                            animate opacity { duration: 100ms; }

                            // Add to Queue Button
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: q_touch.has-hover ? #182233 : CyberTheme.surface;
                                border-width: 1px;
                                border-color: q_touch.has-hover ? CyberTheme.accent : CyberTheme.border;
                                border-radius: 2px;
                                y: (parent.height - self.height) / 2;

                                IconNote {
                                    size: 11px;
                                    icon_color: q_touch.has-hover ? CyberTheme.accent : CyberTheme.muted;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                q_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.add_to_queue_clicked(idx, track.file_path);
                                    }
                                }
                            }

                            // Add to Playlist Button
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: add_t.has-hover ? CyberTheme.accent : CyberTheme.surface;
                                border-width: 1px;
                                border-color: add_t.has-hover ? CyberTheme.accent : CyberTheme.border;
                                border-radius: 2px;
                                y: (parent.height - self.height) / 2;

                                IconPlus {
                                    size: 11px;
                                    icon_color: add_t.has-hover ? CyberTheme.accent_text : CyberTheme.text;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                add_t := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.popup_track_idx == idx) {
                                            root.popup_track_idx = -1;
                                        } else {
                                            root.popup_track_idx = idx;
                                            root.popup_track_path = track.file_path;
                                            pl_popup.show();
                                        }
                                    }
                                }

                                pl_popup := PopupWindow {
                                    x: -160px;
                                    y: 26px;
                                    width: 190px;

                                    Rectangle {
                                        background: #0B0F1A;
                                        border-width: 1px;
                                        border-color: CyberTheme.accent;
                                        border-radius: CyberTheme.radius_sm;
                                        clip: true;

                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 3px;

                                            Text {
                                                text: "// ADD TO PLAYLIST";
                                                font-family: CyberTheme.font_mono;
                                                font-size: 8px;
                                                font-weight: 700;
                                                color: CyberTheme.accent;
                                                height: 16px;
                                                vertical-alignment: center;
                                            }

                                            for p[p_idx] in root.playlists : Rectangle {
                                                height: 24px;
                                                background: pop_touch.has-hover ? CyberTheme.active_row : transparent;
                                                border-radius: 1px;

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    alignment: space-between;

                                                    Text {
                                                        text: p.name;
                                                        font-family: CyberTheme.font_mono;
                                                        font-size: 10px;
                                                        color: pop_touch.has-hover ? #FFFFFF : CyberTheme.text;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }

                                                    Text {
                                                        text: p.track_count + "";
                                                        font-family: CyberTheme.font_mono;
                                                        font-size: 9px;
                                                        color: CyberTheme.muted;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                pop_touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.add_to_playlist_clicked(p.id, root.popup_track_path);
                                                        root.popup_track_idx = -1;
                                                    }
                                                }
                                            }

                                            if (root.playlists.length == 0) : Text {
                                                text: "No playlists created.";
                                                font-family: CyberTheme.font_mono;
                                                font-size: 9px;
                                                color: CyberTheme.muted;
                                                height: 20px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Remove Track (or Delete from disk)
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: rem_t.has-hover ? CyberTheme.cyber_crimson : CyberTheme.surface;
                                border-width: 1px;
                                border-color: rem_t.has-hover ? CyberTheme.cyber_crimson : CyberTheme.border;
                                border-radius: 2px;
                                y: (parent.height - self.height) / 2;

                                IconClose {
                                    size: 10px;
                                    icon_color: rem_t.has-hover ? #FFFFFF : CyberTheme.muted;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                rem_t := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_track_clicked(idx, track.file_path);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= EMPTY STATE =================
        if (root.tracks.length == 0) : Rectangle {
            vertical-stretch: 1;
            background: #080B10;
            border-width: 1px;
            border-color: CyberTheme.border;

            VerticalLayout {
                alignment: center;
                spacing: 14px;

                Rectangle {
                    width: 440px;
                    height: 240px;
                    background: #0D111A;
                    border-width: 1px;
                    border-color: CyberTheme.cyber_crimson;
                    border-radius: CyberTheme.radius_md;
                    clip: true;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "SYS_STATUS // NO_MEDIA_FEED";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                font-weight: 700;
                                color: CyberTheme.cyber_crimson;
                            }
                            Text {
                                text: "ERR::0x00_EMPTY";
                                font-family: CyberTheme.font_mono;
                                font-size: 10px;
                                color: CyberTheme.muted;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "> SCAN_TARGET: %USERPROFILE%\\.synapse";
                                font-family: CyberTheme.font_mono;
                                font-size: 10px;
                                color: CyberTheme.muted;
                            }
                            Text {
                                text: "> DETECTED_AUDIO_STREAMS: 0";
                                font-family: CyberTheme.font_mono;
                                font-size: 10px;
                                color: CyberTheme.muted;
                            }
                            Text {
                                text: "> PROMPT: Open audio directory to populate index.";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                color: CyberTheme.text;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            CyberButton {
                                primary: true;
                                clicked => { root.open_music_dir(); }
                                IconFolder {
                                    size: 13px;
                                    icon_color: parent.icon_color;
                                }
                                text: "OPEN DIRECTORY";
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "PORT::LOCAL_IO";
                                font-family: CyberTheme.font_mono;
                                font-size: 9px;
                                color: CyberTheme.muted;
                            }
                            Text {
                                text: "SYS_BUS::STANDBY";
                                font-family: CyberTheme.font_mono;
                                font-size: 9px;
                                color: CyberTheme.accent;
                            }
                        }
                    }
                }
            }
        }
    }
}
