import { CyberTheme } from "../theme.slint";
import { CyberButton } from "../components/button.slint";
import { ListView } from "std-widgets.slint";
import {
    IconPlay,
    IconSearch,
    IconClose,
    IconFolder,
    IconPlus
} from "../components/icons.slint";

export struct TrackRow {
    file_path: string,
    title: string,
    artist: string,
    bpm: float,
    key_sig: string,
    duration: string,
    is_playing: bool,
}

export component LibraryTable inherits Rectangle {
    in property <[TrackRow]> tracks: [];
    in-out property <string> search_query: "";
    in property <int> active_index: -1;

    callback track_clicked(int, string);
    callback search_changed(string);
    callback add_to_playlist_clicked(int, string);
    callback remove_track_clicked(int, string);
    callback open_music_dir();

    background: #08090D;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ================= SEARCH & TOOLBAR =================
        HorizontalLayout {
            height: 38px;
            spacing: 12px;
            alignment: space-between;

            // Search Bar Input with Tactical Prompt
            search_box := Rectangle {
                horizontal-stretch: 1;
                background: CyberTheme.surface;
                border-width: 1px;
                border-color: search_input.has-focus ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;

                    IconSearch {
                        size: 14px;
                        icon_color: search_input.has-focus ? CyberTheme.accent : CyberTheme.muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Rectangle {
                        horizontal-stretch: 1;

                        if (search_input.text == "") : Text {
                            text: "Search tracks by title, artist, key, bpm...";
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: CyberTheme.muted;
                            vertical-alignment: center;
                        }

                        search_input := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.search_query;
                            font-family: CyberTheme.font_mono;
                            font-size: 12px;
                            color: CyberTheme.text;
                            vertical-alignment: center;
                            edited => {
                                root.search_changed(self.text);
                            }
                        }
                    }

                    if (root.search_query != "") : Rectangle {
                        width: 22px;
                        height: 22px;
                        background: clear_touch.has-hover ? CyberTheme.cyber_crimson : transparent;
                        border-radius: 1px;
                        y: (parent.height - self.height) / 2;

                        IconClose {
                            size: 11px;
                            icon_color: clear_touch.has-hover ? #FFFFFF : CyberTheme.muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        clear_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.search_query = "";
                                root.search_changed("");
                            }
                        }
                    }
                }
            }

            CyberButton {
                clicked => { root.open_music_dir(); }
                IconFolder {
                    size: 14px;
                    icon_color: parent.icon_color;
                }
                text: "OPEN DIRECTORY";
            }
        }

        // ================= TABLE OR EMPTY STATE =================
        if (root.tracks.length > 0) : VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // Crisp Column Headers
            Rectangle {
                height: 34px;
                background: #0E121A;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: CyberTheme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "#";
                        width: 44px;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "TRACK TITLE";
                        horizontal-stretch: 3;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "ARTIST";
                        horizontal-stretch: 2;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "BPM";
                        width: 64px;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "KEY";
                        width: 64px;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "DURATION";
                        width: 70px;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "ACTIONS";
                        width: 80px;
                        font-family: CyberTheme.font_mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: CyberTheme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            // Virtualized Track Rows via ListView (Memory Retaining <30MB)
            ListView {
                vertical-stretch: 1;

                for track[idx] in root.tracks : Rectangle {
                    height: 40px;
                    background: track.is_playing ? CyberTheme.active_row :
                                (row_touch.has-hover ? #121722 : (Math.mod(idx, 2) == 0 ? #090B10 : #06080C));

                    // Active playing row: Glowing left neon border
                    if (track.is_playing || root.active_index == idx) : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 3px;
                        height: parent.height;
                        background: track.is_playing ? CyberTheme.cyber_green : CyberTheme.accent;
                    }

                    // Bottom divider line
                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: #111520;
                    }

                    // Background clickable touch area
                    row_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.track_clicked(idx, track.file_path);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        // # or Vector Play State Icon
                        Rectangle {
                            width: 44px;
                            HorizontalLayout {
                                alignment: center;
                                if (track.is_playing) : IconPlay {
                                    size: 12px;
                                    icon_color: CyberTheme.cyber_green;
                                    y: (parent.height - self.height) / 2;
                                }
                                if (!track.is_playing) : Text {
                                    text: (idx + 1);
                                    font-family: CyberTheme.font_mono;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: CyberTheme.muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Track Title
                        Text {
                            text: track.title;
                            horizontal-stretch: 3;
                            font-family: CyberTheme.font_mono;
                            font-size: 12px;
                            font-weight: track.is_playing ? 700 : 500;
                            color: track.is_playing ? CyberTheme.accent : (row_touch.has-hover ? #FFFFFF : CyberTheme.text);
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        // Artist (Centered)
                        Text {
                            text: track.artist;
                            horizontal-stretch: 2;
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: track.is_playing ? CyberTheme.accent : CyberTheme.muted;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        // BPM (Centered)
                        Text {
                            text: Math.round(track.bpm);
                            width: 64px;
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: CyberTheme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        // Key Badge with Camelot Distinct Colors (Centered)
                        Rectangle {
                            width: 64px;
                            HorizontalLayout {
                                alignment: center;
                                key_badge := Rectangle {
                                    property <color> badge_bg: (track.key_sig == "8A" || track.key_sig == "8B" || track.key_sig == "7A" || track.key_sig == "7B" || track.key_sig == "9A" || track.key_sig == "9B") ? #00FF6622 :
                                                               (track.key_sig == "4A" || track.key_sig == "4B" || track.key_sig == "5A" || track.key_sig == "5B" || track.key_sig == "6A" || track.key_sig == "6B") ? #FF990022 :
                                                               (track.key_sig == "" || track.key_sig == "--") ? #18202E : #00F0FF22;
                                    property <color> badge_border: (track.key_sig == "8A" || track.key_sig == "8B" || track.key_sig == "7A" || track.key_sig == "7B" || track.key_sig == "9A" || track.key_sig == "9B") ? #00FF6677 :
                                                                   (track.key_sig == "4A" || track.key_sig == "4B" || track.key_sig == "5A" || track.key_sig == "5B" || track.key_sig == "6A" || track.key_sig == "6B") ? #FF990077 :
                                                                   (track.key_sig == "" || track.key_sig == "--") ? CyberTheme.border : #00F0FF77;
                                    property <color> badge_fg: (track.key_sig == "8A" || track.key_sig == "8B" || track.key_sig == "7A" || track.key_sig == "7B" || track.key_sig == "9A" || track.key_sig == "9B") ? CyberTheme.cyber_green :
                                                               (track.key_sig == "4A" || track.key_sig == "4B" || track.key_sig == "5A" || track.key_sig == "5B" || track.key_sig == "6A" || track.key_sig == "6B") ? CyberTheme.cyber_amber :
                                                               (track.key_sig == "" || track.key_sig == "--") ? CyberTheme.muted : CyberTheme.cyber_cyan;

                                    height: 20px;
                                    background: self.badge_bg;
                                    border-width: 1px;
                                    border-color: self.badge_border;
                                    border-radius: 2px;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: track.key_sig != "" ? track.key_sig : "--";
                                            font-family: CyberTheme.font_mono;
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: key_badge.badge_fg;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Duration (Centered)
                        Text {
                            text: track.duration;
                            width: 70px;
                            font-family: CyberTheme.font_mono;
                            font-size: 11px;
                            color: CyberTheme.muted;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        // Actions (Centered)
                        HorizontalLayout {
                            width: 80px;
                            spacing: 6px;
                            alignment: center;

                            // Add to Playlist Button with IconPlus
                            add_btn := Rectangle {
                                width: 26px;
                                height: 26px;
                                background: add_t.has-hover ? CyberTheme.accent : CyberTheme.surface;
                                border-width: 1px;
                                border-color: add_t.has-hover ? CyberTheme.accent : CyberTheme.border;
                                border-radius: 2px;
                                y: (parent.height - self.height) / 2;

                                IconPlus {
                                    size: 12px;
                                    icon_color: add_t.has-hover ? CyberTheme.accent_text : CyberTheme.text;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                add_t := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.add_to_playlist_clicked(idx, track.file_path);
                                    }
                                }
                            }

                            // Remove Track Button with IconClose
                            rem_btn := Rectangle {
                                width: 26px;
                                height: 26px;
                                background: rem_t.has-hover ? CyberTheme.cyber_crimson : CyberTheme.surface;
                                border-width: 1px;
                                border-color: rem_t.has-hover ? CyberTheme.cyber_crimson : CyberTheme.border;
                                border-radius: 2px;
                                y: (parent.height - self.height) / 2;

                                IconClose {
                                    size: 11px;
                                    icon_color: rem_t.has-hover ? #FFFFFF : CyberTheme.muted;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                rem_t := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.remove_track_clicked(idx, track.file_path);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= EMPTY STATE BANNER =================
        if (root.tracks.length == 0) : Rectangle {
            vertical-stretch: 1;
            background: #080B10;
            border-width: 1px;
            border-color: CyberTheme.border;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                // Terminal card
                Rectangle {
                    width: 480px;
                    height: 260px;
                    background: #0D111A;
                    border-width: 1px;
                    border-color: CyberTheme.cyber_crimson;
                    border-radius: CyberTheme.radius_md;
                    clip: true;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: space-between;

                        // Header bar
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "SYS_STATUS // NO_MEDIA_FEED";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                font-weight: 700;
                                color: CyberTheme.cyber_crimson;
                            }
                            Text {
                                text: "ERR::0x00_EMPTY";
                                font-family: CyberTheme.font_mono;
                                font-size: 10px;
                                color: CyberTheme.muted;
                            }
                        }

                        // Terminal log output
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "> SCAN_TARGET: %USERPROFILE%\\.synapse";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                color: CyberTheme.muted;
                            }
                            Text {
                                text: "> DETECTED_AUDIO_STREAMS: 0";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                color: CyberTheme.muted;
                            }
                            Text {
                                text: "> PROMPT: Direct audio bus connection required.";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                color: CyberTheme.text;
                            }
                        }

                        // Action button
                        HorizontalLayout {
                            alignment: center;
                            CyberButton {
                                primary: true;
                                clicked => { root.open_music_dir(); }
                                IconFolder {
                                    size: 14px;
                                    icon_color: parent.icon_color;
                                }
                                text: "OPEN DIRECTORY";
                            }
                        }

                        // Footer
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "PORT::LOCAL_IO";
                                font-family: CyberTheme.font_mono;
                                font-size: 9px;
                                color: CyberTheme.muted;
                            }
                            Text {
                                text: "SYS_BUS::STANDBY";
                                font-family: CyberTheme.font_mono;
                                font-size: 9px;
                                color: CyberTheme.accent;
                            }
                        }
                    }
                }
            }
        }
    }
}
