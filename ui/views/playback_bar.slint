import { CyberTheme } from "../theme.slint";
import { CyberButton } from "../components/button.slint";
import { CyberSlider } from "../components/slider.slint";
import {
    IconPlay,
    IconPause,
    IconNext,
    IconPrev,
    IconShuffle,
    IconRepeat,
    IconQueue,
    IconVolume,
    IconVolumeMute,
    IconBolt,
    IconDisc,
    IconClose
} from "../components/icons.slint";

export struct QueueRow {
    file_path: string,
    title: string,
    artist: string,
}

export component PlaybackBar inherits Rectangle {
    in property <image> cover_art;
    in property <bool> has_cover: false;
    in property <string> track_title: "No Track Selected";
    in property <string> track_artist: "Unknown Artist";
    in property <string> track_mood: "NEURAL";
    in property <float> bpm: 128.0;
    in property <string> key_sig: "8A";
    in property <bool> is_playing: false;
    in property <bool> is_automix: false;
    in-out property <bool> is_shuffle: false;
    in-out property <bool> is_repeat: false;
    in property <float> current_position: 0.0;
    in property <float> total_duration: 180.0;
    in property <string> time_formatted: "00:00";
    in property <string> duration_formatted: "03:00";
    in-out property <float> volume: 0.8;
    in property <bool> is_muted: false;

    // Queue properties
    in property <[QueueRow]> queue_items: [];
    in property <int> queue_count: 0;

    callback play_pause_clicked();
    callback prev_clicked();
    callback next_clicked();
    callback shuffle_toggled();
    callback repeat_toggled();
    callback automix_toggled();
    callback seek_changed(float);
    callback volume_changed(float);
    callback mute_toggled();
    callback title_clicked(string);
    callback artist_clicked(string);
    callback remove_from_queue(int);
    callback clear_queue();

    height: 82px;
    background: #090C12;
    border-width: 1px;
    border-color: CyberTheme.border;

    // Top neon accent line with playback reactivity
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: root.is_playing ? CyberTheme.cyber_cyan : CyberTheme.accent;
        opacity: root.is_playing ? 0.9 : 0.25;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 14px;
        alignment: space-between;

        // ================= LEFT: TRACK META & COVER (width: ~280px) =================
        HorizontalLayout {
            width: 280px;
            spacing: 12px;
            alignment: start;

            // Cover Art Container (48x48 px)
            Rectangle {
                width: 48px;
                height: 48px;
                y: (parent.height - self.height) / 2;
                background: CyberTheme.surface;
                border-width: 1px;
                border-color: root.is_playing ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;
                clip: true;

                if (root.has_cover) : Image {
                    source: root.cover_art;
                    width: 100%;
                    height: 100%;
                }

                if (!root.has_cover) : Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #0B0F18;

                    IconDisc {
                        size: 24px;
                        icon_color: root.is_playing ? CyberTheme.accent : CyberTheme.muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Track Info Text with badges
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                // Title (Click to copy)
                HorizontalLayout {
                    title_t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.title_clicked(root.track_title); }
                    }

                    Text {
                        text: root.track_title;
                        font-family: CyberTheme.font_mono;
                        font-size: 12px;
                        font-weight: 700;
                        color: title_t.has-hover ? CyberTheme.accent : CyberTheme.text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // Artist (Click to filter)
                HorizontalLayout {
                    art_t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.artist_clicked(root.track_artist); }
                    }

                    Text {
                        text: root.track_artist;
                        font-family: CyberTheme.font_mono;
                        font-size: 11px;
                        font-weight: 600;
                        color: art_t.has-hover ? #FFFFFF : CyberTheme.accent;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // Metadata Badges: BPM Pill, Key Pill, Mood Badge
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    // BPM Pill
                    Rectangle {
                        height: 16px;
                        background: #111724;
                        border-width: 1px;
                        border-color: CyberTheme.border;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: Math.round(root.bpm) + " BPM";
                                font-family: CyberTheme.font_mono;
                                font-size: 8px;
                                font-weight: 600;
                                color: CyberTheme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Key Badge
                    Rectangle {
                        height: 16px;
                        background: #00F0FF14;
                        border-width: 1px;
                        border-color: #00F0FF66;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: root.key_sig != "" ? root.key_sig : "--";
                                font-family: CyberTheme.font_mono;
                                font-size: 8px;
                                font-weight: 700;
                                color: CyberTheme.cyber_cyan;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Mood Badge
                    if (root.track_mood != "") : Rectangle {
                        height: 16px;
                        background: CyberTheme.active_row;
                        border-width: 1px;
                        border-color: CyberTheme.accent;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: "[ " + root.track_mood + " ]";
                                font-family: CyberTheme.font_mono;
                                font-size: 8px;
                                font-weight: 700;
                                color: CyberTheme.accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ================= CENTER: TRANSPORT & WIDE SEEKER =================
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;

            // Transport Buttons Row
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: 8px;

                // Shuffle Button
                CyberButton {
                    width: 34px;
                    height: 32px;
                    compact: true;
                    active: root.is_shuffle;
                    clicked => {
                        root.is_shuffle = !root.is_shuffle;
                        root.shuffle_toggled();
                    }
                    IconShuffle {
                        size: 14px;
                        icon_color: root.is_shuffle ? CyberTheme.accent : parent.icon_color;
                    }
                }

                // Previous Track
                CyberButton {
                    width: 36px;
                    height: 32px;
                    compact: true;
                    clicked => { root.prev_clicked(); }
                    IconPrev {
                        size: 14px;
                        icon_color: parent.icon_color;
                    }
                }

                // Primary Play / Pause Button
                CyberButton {
                    width: 96px;
                    height: 34px;
                    primary: true;
                    compact: true;
                    clicked => { root.play_pause_clicked(); }

                    if (!root.is_playing) : IconPlay {
                        size: 14px;
                        icon_color: parent.icon_color;
                    }
                    if (root.is_playing) : IconPause {
                        size: 14px;
                        icon_color: parent.icon_color;
                    }

                    text: root.is_playing ? "PAUSE" : "PLAY";
                }

                // Next Track
                CyberButton {
                    width: 36px;
                    height: 32px;
                    compact: true;
                    clicked => { root.next_clicked(); }
                    IconNext {
                        size: 14px;
                        icon_color: parent.icon_color;
                    }
                }

                // Repeat Button
                CyberButton {
                    width: 34px;
                    height: 32px;
                    compact: true;
                    active: root.is_repeat;
                    clicked => {
                        root.is_repeat = !root.is_repeat;
                        root.repeat_toggled();
                    }
                    IconRepeat {
                        size: 14px;
                        icon_color: root.is_repeat ? CyberTheme.accent : parent.icon_color;
                    }
                }

                // Automix Toggle Button
                CyberButton {
                    width: 116px;
                    height: 32px;
                    active: root.is_automix;
                    compact: true;
                    clicked => { root.automix_toggled(); }

                    IconBolt {
                        size: 13px;
                        icon_color: root.is_automix ? CyberTheme.cyber_yellow : parent.icon_color;
                    }

                    text: root.is_automix ? "AUTOMIX: ON" : "AUTOMIX";
                }
            }

            // WIDE SEEKER ROW
            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                cross-axis-alignment: center;

                Text {
                    text: root.time_formatted;
                    font-family: CyberTheme.font_mono;
                    font-size: 11px;
                    font-weight: 700;
                    color: CyberTheme.accent;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: right;
                    horizontal-stretch: 0;
                }

                CyberSlider {
                    horizontal-stretch: 1;
                    height: 24px;
                    track_thickness: 5px;
                    thumb_width: 14px;
                    thumb_height: 20px;
                    minimum: 0.0;
                    maximum: Math.max(1.0, root.total_duration);
                    value: root.current_position;
                    changed(val) => { root.seek_changed(val); }
                }

                Text {
                    text: root.duration_formatted;
                    font-family: CyberTheme.font_mono;
                    font-size: 11px;
                    font-weight: 600;
                    color: CyberTheme.muted;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: left;
                    horizontal-stretch: 0;
                }
            }
        }

        // ================= RIGHT: QUEUE & VOLUME CONTROL =================
        HorizontalLayout {
            width: 210px;
            spacing: 8px;
            alignment: end;

            // Queue Popover Button
            queue_box := Rectangle {
                width: 36px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                background: q_btn_touch.has-hover ? #182233 : CyberTheme.surface;
                border-width: 1px;
                border-color: q_btn_touch.has-hover ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;

                IconQueue {
                    size: 14px;
                    icon_color: root.queue_count > 0 ? CyberTheme.accent : CyberTheme.muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                // Queue Count Badge
                if (root.queue_count > 0) : Rectangle {
                    x: parent.width - 12px;
                    y: -2px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: CyberTheme.accent;

                    Text {
                        text: root.queue_count + "";
                        font-family: CyberTheme.font_mono;
                        font-size: 8px;
                        font-weight: 700;
                        color: CyberTheme.accent_text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                q_btn_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        queue_popup.show();
                    }
                }

                queue_popup := PopupWindow {
                    x: -200px;
                    y: -180px;
                    width: 240px;
                    height: 170px;

                    Rectangle {
                        background: #0B0E18;
                        border-width: 1px;
                        border-color: CyberTheme.accent;
                        border-radius: CyberTheme.radius_sm;
                        clip: true;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "// UP NEXT QUEUE (" + root.queue_count + ")";
                                    font-family: CyberTheme.font_mono;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: CyberTheme.accent;
                                    vertical-alignment: center;
                                }

                                if (root.queue_count > 0) : Rectangle {
                                    width: 44px;
                                    height: 18px;
                                    background: clear_q_touch.has-hover ? CyberTheme.cyber_crimson : #141A26;
                                    border-radius: 1px;

                                    Text {
                                        text: "CLEAR";
                                        font-family: CyberTheme.font_mono;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: clear_q_touch.has-hover ? #FFFFFF : CyberTheme.muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    clear_q_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.clear_queue();
                                        }
                                    }
                                }
                            }

                            // Items List
                            VerticalLayout {
                                spacing: 2px;
                                vertical-stretch: 1;

                                for q_item[q_idx] in root.queue_items : Rectangle {
                                    height: 24px;
                                    background: #111624;
                                    border-radius: 1px;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            horizontal-stretch: 1;

                                            Text {
                                                text: (q_idx + 1) + ".";
                                                font-family: CyberTheme.font_mono;
                                                font-size: 9px;
                                                color: CyberTheme.accent;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: q_item.title;
                                                font-family: CyberTheme.font_mono;
                                                font-size: 10px;
                                                color: CyberTheme.text;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            y: (parent.height - self.height) / 2;

                                            IconClose {
                                                size: 9px;
                                                icon_color: del_q_t.has-hover ? CyberTheme.cyber_crimson : CyberTheme.muted;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            del_q_t := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.remove_from_queue(q_idx);
                                                }
                                            }
                                        }
                                    }
                                }

                                if (root.queue_count == 0) : Text {
                                    text: "Queue is empty. Use action button to add tracks.";
                                    font-family: CyberTheme.font_mono;
                                    font-size: 9px;
                                    color: CyberTheme.muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Volume Mute Button
            Rectangle {
                width: 30px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                background: mute_touch.has-hover ? #182233 : CyberTheme.surface;
                border-width: 1px;
                border-color: mute_touch.has-hover ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;

                if (!root.is_muted && root.volume > 0.0) : IconVolume {
                    size: 14px;
                    icon_color: mute_touch.has-hover ? CyberTheme.accent : CyberTheme.text;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                if (root.is_muted || root.volume == 0.0) : IconVolumeMute {
                    size: 14px;
                    icon_color: CyberTheme.cyber_crimson;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                mute_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mute_toggled(); }
                }
            }

            // Volume Slider
            CyberSlider {
                width: 84px;
                height: 22px;
                track_thickness: 4px;
                thumb_width: 10px;
                thumb_height: 16px;
                minimum: 0.0;
                maximum: 1.0;
                value: root.is_muted ? 0.0 : root.volume;
                changed(val) => {
                    root.volume = val;
                    root.volume_changed(val);
                }
                y: (parent.height - self.height) / 2;
            }

            // Volume Percentage Label
            Text {
                text: (root.is_muted ? 0 : Math.round(root.volume * 100)) + "%";
                font-family: CyberTheme.font_mono;
                font-size: 9px;
                font-weight: 700;
                color: root.is_muted ? CyberTheme.cyber_crimson : CyberTheme.muted;
                vertical-alignment: center;
                width: 30px;
                horizontal-alignment: left;
            }
        }
    }
}
