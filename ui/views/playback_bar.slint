import { CyberTheme } from "../theme.slint";
import { CyberButton } from "../components/button.slint";
import { CyberSlider } from "../components/slider.slint";
import {
    IconPlay,
    IconPause,
    IconNext,
    IconPrev,
    IconVolume,
    IconVolumeMute,
    IconBolt,
    IconDisc
} from "../components/icons.slint";

export component PlaybackBar inherits Rectangle {
    in property <image> cover_art;
    in property <bool> has_cover: false;
    in property <string> track_title: "No Track Selected";
    in property <string> track_artist: "Unknown Artist";
    in property <string> track_mood: "NEURAL";
    in property <float> bpm: 128.0;
    in property <string> key_sig: "8A";
    in property <bool> is_playing: false;
    in property <bool> is_automix: false;
    in property <float> current_position: 0.0;
    in property <float> total_duration: 180.0;
    in property <string> time_formatted: "00:00";
    in property <string> duration_formatted: "03:00";
    in-out property <float> volume: 0.8;
    in property <bool> is_muted: false;

    callback play_pause_clicked();
    callback prev_clicked();
    callback next_clicked();
    callback automix_toggled();
    callback seek_changed(float);
    callback volume_changed(float);
    callback mute_toggled();

    height: 80px;
    background: #090C12;
    border-width: 1px;
    border-color: CyberTheme.border;

    // Top neon accent line with playback reactivity
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: root.is_playing ? CyberTheme.cyber_cyan : CyberTheme.accent;
        opacity: root.is_playing ? 0.9 : 0.25;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;
        alignment: space-between;

        // ================= LEFT: TRACK META & COVER (width: ~300px) =================
        HorizontalLayout {
            width: 300px;
            spacing: 12px;
            alignment: start;

            // Cover Art Container (48x48 px with 45-degree chamfer brackets)
            cover_container := Rectangle {
                width: 48px;
                height: 48px;
                y: (parent.height - self.height) / 2;
                background: CyberTheme.surface;
                border-width: 1px;
                border-color: root.is_playing ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;
                clip: true;

                // 45-degree chamfer corner brackets
                Path {
                    x: parent.width - 6px;
                    y: 0px;
                    width: 6px;
                    height: 6px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 6;
                    viewbox-height: 6;
                    fill: root.is_playing ? CyberTheme.accent : CyberTheme.border;
                    commands: "M 0 0 L 6 0 L 6 6 Z";
                }
                Path {
                    x: 0px;
                    y: parent.height - 6px;
                    width: 6px;
                    height: 6px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 6;
                    viewbox-height: 6;
                    fill: root.is_playing ? CyberTheme.accent : CyberTheme.border;
                    commands: "M 0 0 L 0 6 L 6 6 Z";
                }

                if (root.has_cover) : Image {
                    source: root.cover_art;
                    width: 100%;
                    height: 100%;
                }

                // Fallback: Tactical Vinyl Disc Reticle
                if (!root.has_cover) : Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #0B0F18;

                    // Subtle HUD crosshair
                    Rectangle {
                        x: 4px;
                        y: 23px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: #172233;
                    }
                    Rectangle {
                        x: 23px;
                        y: 4px;
                        width: 1px;
                        height: parent.height - 8px;
                        background: #172233;
                    }

                    IconDisc {
                        size: 26px;
                        icon_color: root.is_playing ? CyberTheme.accent : CyberTheme.muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Track Info Text with badges
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;

                Text {
                    text: root.track_title;
                    font-family: CyberTheme.font_mono;
                    font-size: 13px;
                    font-weight: 700;
                    color: CyberTheme.text;
                    overflow: elide;
                }

                Text {
                    text: root.track_artist;
                    font-family: CyberTheme.font_mono;
                    font-size: 11px;
                    font-weight: 600;
                    color: CyberTheme.accent;
                    overflow: elide;
                }

                // Metadata Badges: BPM Pill, Key Pill, Mood Badge
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    // BPM Pill
                    Rectangle {
                        height: 16px;
                        background: #111724;
                        border-width: 1px;
                        border-color: CyberTheme.border;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: Math.round(root.bpm) + " BPM";
                                font-family: CyberTheme.font_mono;
                                font-size: 9px;
                                font-weight: 600;
                                color: CyberTheme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Key Badge (Tactical Chamfered Pill)
                    Rectangle {
                        height: 16px;
                        background: #00F0FF14;
                        border-width: 1px;
                        border-color: #00F0FF66;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: root.key_sig != "" ? root.key_sig : "--";
                                font-family: CyberTheme.font_mono;
                                font-size: 9px;
                                font-weight: 700;
                                color: CyberTheme.cyber_cyan;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Mood Badge
                    if (root.track_mood != "") : Rectangle {
                        height: 16px;
                        background: CyberTheme.active_row;
                        border-width: 1px;
                        border-color: CyberTheme.accent;
                        border-radius: 2px;

                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: "[ " + root.track_mood + " ]";
                                font-family: CyberTheme.font_mono;
                                font-size: 8px;
                                font-weight: 700;
                                color: CyberTheme.accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ================= CENTER: TRANSPORT & WIDE SEEKER =================
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            // Transport Buttons Row
            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                // Previous Track Button
                CyberButton {
                    width: 36px;
                    height: 34px;
                    compact: true;
                    clicked => { root.prev_clicked(); }
                    IconPrev {
                        size: 14px;
                        icon_color: parent.icon_color;
                    }
                }

                // Primary Play / Pause Button with Glowing State
                CyberButton {
                    width: 96px;
                    height: 34px;
                    primary: true;
                    compact: true;
                    clicked => { root.play_pause_clicked(); }

                    if (!root.is_playing) : IconPlay {
                        size: 15px;
                        icon_color: parent.icon_color;
                    }
                    if (root.is_playing) : IconPause {
                        size: 15px;
                        icon_color: parent.icon_color;
                    }

                    text: root.is_playing ? "PAUSE" : "PLAY";
                }

                // Next Track Button
                CyberButton {
                    width: 36px;
                    height: 34px;
                    compact: true;
                    clicked => { root.next_clicked(); }
                    IconNext {
                        size: 14px;
                        icon_color: parent.icon_color;
                    }
                }

                // Automix Toggle Button
                CyberButton {
                    width: 114px;
                    height: 34px;
                    active: root.is_automix;
                    compact: true;
                    clicked => { root.automix_toggled(); }

                    IconBolt {
                        size: 13px;
                        icon_color: root.is_automix ? CyberTheme.cyber_yellow : parent.icon_color;
                    }

                    text: root.is_automix ? "AUTOMIX: ON" : "AUTOMIX";
                }
            }

            // WIDE SEEKER ROW: Monospace timestamps + CyberSlider
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Text {
                    text: root.time_formatted;
                    font-family: CyberTheme.font_mono;
                    font-size: 11px;
                    font-weight: 700;
                    color: CyberTheme.accent;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: right;
                }

                CyberSlider {
                    horizontal-stretch: 1;
                    height: 20px;
                    minimum: 0.0;
                    maximum: Math.max(1.0, root.total_duration);
                    value: root.current_position;
                    changed(val) => { root.seek_changed(val); }
                }

                Text {
                    text: root.duration_formatted;
                    font-family: CyberTheme.font_mono;
                    font-size: 11px;
                    font-weight: 600;
                    color: CyberTheme.muted;
                    vertical-alignment: center;
                    width: 44px;
                    horizontal-alignment: left;
                }
            }
        }

        // ================= RIGHT: VOLUME CONTROL =================
        HorizontalLayout {
            width: 175px;
            spacing: 10px;
            alignment: end;

            // Volume Mute Button
            mute_btn := Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - self.height) / 2;
                background: mute_touch.has-hover ? #182233 : CyberTheme.surface;
                border-width: 1px;
                border-color: mute_touch.has-hover ? CyberTheme.accent : CyberTheme.border;
                border-radius: CyberTheme.radius_sm;

                if (!root.is_muted && root.volume > 0.0) : IconVolume {
                    size: 15px;
                    icon_color: mute_touch.has-hover ? CyberTheme.accent : CyberTheme.text;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                if (root.is_muted || root.volume == 0.0) : IconVolumeMute {
                    size: 15px;
                    icon_color: CyberTheme.cyber_crimson;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                mute_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mute_toggled(); }
                }
            }

            // Volume Slider
            CyberSlider {
                width: 90px;
                height: 20px;
                minimum: 0.0;
                maximum: 1.0;
                value: root.is_muted ? 0.0 : root.volume;
                changed(val) => {
                    root.volume = val;
                    root.volume_changed(val);
                }
                y: (parent.height - self.height) / 2;
            }

            // Volume Percentage Label
            Text {
                text: (root.is_muted ? 0 : Math.round(root.volume * 100)) + "%";
                font-family: CyberTheme.font_mono;
                font-size: 10px;
                font-weight: 700;
                color: root.is_muted ? CyberTheme.cyber_crimson : CyberTheme.muted;
                vertical-alignment: center;
                width: 34px;
                horizontal-alignment: left;
            }
        }
    }
}
