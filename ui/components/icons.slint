export component IconWave inherits Rectangle {
    in property <color> icon_color: #00F0FF;
    in property <length> size: 16px;
    width: size;
    height: size;
    background: transparent;

    HorizontalLayout {
        spacing: size * 0.12;
        alignment: center;

        Rectangle {
            width: root.size * 0.16;
            height: root.size * 0.45;
            background: root.icon_color;
            border-radius: 1px;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            width: root.size * 0.16;
            height: root.size * 0.85;
            background: root.icon_color;
            border-radius: 1px;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            width: root.size * 0.16;
            height: root.size * 0.60;
            background: root.icon_color;
            border-radius: 1px;
            y: (parent.height - self.height) / 2;
        }
    }
}

