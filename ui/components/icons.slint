// Synapse Cyberpunk DAW - Vector Icons Library
// Crisp, pixel-perfect, zero-emoji vector iconography

export component IconPlay inherits Path {
    in property <color> icon_color: #F2F5F8;
    in property <length> size: 16px;
    width: size;
    height: size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: icon_color;
    commands: "M 7 4 L 20 12 L 7 20 Z";
}

