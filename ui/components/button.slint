import { CyberTheme } from "../theme.slint";

export component CyberButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> secondary: false;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <length> font_size: 12px;
    in property <bool> compact: false;
    
    // Icon color accessor for child icons
    out property <color> icon_color: disabled ? CyberTheme.muted :
                                    primary ? (touch.has-hover ? #000000 : CyberTheme.accent_text) :
                                    (active || touch.has-hover) ? CyberTheme.accent : CyberTheme.text;
    out property <bool> has_hover: touch.has-hover;

    callback clicked();

    min-height: compact ? 26px : 34px;
    min-width: compact ? (text != "" ? 30px : 26px) : (text != "" ? 70px : 34px);
    clip: true;

    // Base background and border styling
    background: disabled ? CyberTheme.surface :
                primary ? (touch.pressed ? CyberTheme.dark : (touch.has-hover ? #FFFFFF : CyberTheme.accent)) :
                active ? CyberTheme.active_row :
                (touch.has-hover ? #181E2B : CyberTheme.surface);

    border-width: 1px;
    border-color: disabled ? CyberTheme.border :
                  primary ? CyberTheme.accent :
                  (active || touch.has-hover) ? CyberTheme.accent : CyberTheme.border;
    border-radius: CyberTheme.radius_sm;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    // Outer neon glow simulation on hover
    if (touch.has-hover && !disabled) : Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-width: 1px;
        border-color: CyberTheme.accent;
        opacity: 0.5;
        border-radius: CyberTheme.radius_sm;
    }

    // Authentic Cyberpunk chamfer corner notches (45-degree corner triangles)
    Path {
        x: parent.width - 7px;
        y: 0px;
        width: 7px;
        height: 7px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 7;
        viewbox-height: 7;
        fill: disabled ? CyberTheme.border : (primary ? CyberTheme.accent_text : CyberTheme.accent);
        opacity: (touch.has-hover || primary || active) ? 1.0 : 0.45;
        commands: "M 0 0 L 7 0 L 7 7 Z";
    }

    Path {
        x: 0px;
        y: parent.height - 7px;
        width: 7px;
        height: 7px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 7;
        viewbox-height: 7;
        fill: disabled ? CyberTheme.border : (primary ? CyberTheme.accent_text : CyberTheme.accent);
        opacity: (touch.has-hover || primary || active) ? 1.0 : 0.45;
        commands: "M 0 0 L 0 7 L 7 7 Z";
    }

    // Active bottom-accent neon strip
    if (active && !primary) : Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: CyberTheme.accent;
    }

    // Content container (Supports icon children + text)
    HorizontalLayout {
        padding-left: compact ? (root.text != "" ? 8px : 4px) : (root.text != "" ? 12px : 8px);
        padding-right: compact ? (root.text != "" ? 8px : 4px) : (root.text != "" ? 12px : 8px);
        padding-top: compact ? 2px : 6px;
        padding-bottom: compact ? 2px : 6px;
        alignment: center;
        spacing: 6px;

        @children

        if (root.text != "") : Text {
            text: root.text;
            font-family: CyberTheme.font_mono;
            font-size: root.font_size;
            font-weight: (primary || active) ? 700 : 600;
            letter-spacing: 0.5px;
            color: root.icon_color;
            vertical-alignment: center;
            horizontal-alignment: center;
            animate color { duration: 100ms; }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            root.clicked();
        }
    }
}
