import { CyberTheme } from "../theme.slint";

export component CyberButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> secondary: false;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <length> font_size: 12px;
    in property <bool> compact: false;
    
    callback clicked();

    min-height: compact ? 26px : 34px;
    min-width: compact ? 30px : 70px;
    clip: true;

    // Base background and border styling
    background: disabled ? CyberTheme.surface :
                primary ? (touch.pressed ? CyberTheme.dark : (touch.has-hover ? #FFFFFF : CyberTheme.accent)) :
                active ? CyberTheme.active_row :
                (touch.has-hover ? #181E2B : CyberTheme.surface);

    border-width: 1px;
    border-color: disabled ? CyberTheme.border :
                  primary ? CyberTheme.accent :
                  (active || touch.has-hover) ? CyberTheme.accent : CyberTheme.border;
    border-radius: CyberTheme.radius_sm;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    // Outer neon glow simulation on hover
    if (touch.has-hover && !disabled) : Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-width: 1px;
        border-color: CyberTheme.accent;
        opacity: 0.5;
        border-radius: CyberTheme.radius_sm;
    }

    // Cyberpunk chamfer corner indicators (Top-Right and Bottom-Left notches)
    Rectangle {
        x: parent.width - 6px;
        y: 0px;
        width: 6px;
        height: 6px;
        background: disabled ? CyberTheme.border : (primary ? CyberTheme.accent_text : CyberTheme.accent);
        opacity: (touch.has-hover || primary || active) ? 1.0 : 0.4;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 6px;
        width: 6px;
        height: 6px;
        background: disabled ? CyberTheme.border : (primary ? CyberTheme.accent_text : CyberTheme.accent);
        opacity: (touch.has-hover || primary || active) ? 1.0 : 0.4;
    }

    // Active bottom-accent strip
    if (active && !primary) : Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: CyberTheme.accent;
    }

    // Content container
    HorizontalLayout {
        padding-left: compact ? 6px : 12px;
        padding-right: compact ? 6px : 12px;
        padding-top: compact ? 2px : 6px;
        padding-bottom: compact ? 2px : 6px;
        alignment: center;
        spacing: 6px;

        @children

        if (root.text != "") : Text {
            text: root.text;
            font-family: CyberTheme.font_mono;
            font-size: root.font_size;
            font-weight: (primary || active) ? 700 : 600;
            letter-spacing: 0.5px;
            color: disabled ? CyberTheme.muted :
                   primary ? (touch.has-hover ? #000000 : CyberTheme.accent_text) :
                   (active || touch.has-hover) ? CyberTheme.accent : CyberTheme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
            animate color { duration: 100ms; }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            root.clicked();
        }
    }
}
