import { CyberTheme } from "../theme.slint";

export component CyberButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> secondary: false;
    in property <bool> active: false;
    in property <bool> disabled: false;
    in property <length> font_size: 11px;
    in property <bool> compact: false;
    
    // Icon color accessor for child icons
    out property <color> icon_color: disabled ? CyberTheme.muted :
                                    primary ? (touch.pressed ? #000000 : CyberTheme.accent_text) :
                                    (active || touch.has-hover) ? CyberTheme.accent : CyberTheme.text;
    out property <bool> has_hover: touch.has-hover;

    callback clicked();

    min-height: compact ? 26px : 32px;
    min-width: text == "" ? (compact ? 26px : 32px) : 0px;
    horizontal-stretch: 0;
    clip: true;

    // Base background styling
    background: disabled ? #0C0F17 :
                primary ? (touch.pressed ? CyberTheme.dark : (touch.has-hover ? #FFF533 : CyberTheme.accent)) :
                active ? CyberTheme.active_row :
                (touch.has-hover ? #151A26 : CyberTheme.surface);

    border-width: 1px;
    border-color: disabled ? #182030 :
                  primary ? (touch.has-hover ? #FFFFFF : CyberTheme.accent) :
                  active ? CyberTheme.accent :
                  (touch.has-hover ? CyberTheme.accent : CyberTheme.border);
    border-radius: CyberTheme.radius_sm;

    animate background { duration: 100ms; easing: ease-out; }
    animate border-color { duration: 100ms; easing: ease-out; }

    // Subtle neon glow simulation on hover
    if (touch.has-hover && !disabled && !primary) : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: CyberTheme.accent;
        opacity: 0.35;
        border-radius: CyberTheme.radius_sm;
    }

    // Top-right micro HUD corner tick
    Rectangle {
        x: parent.width - 4px;
        y: 0px;
        width: 4px;
        height: 2px;
        background: primary ? CyberTheme.accent_text : (touch.has-hover || active ? CyberTheme.accent : transparent);
    }

    // Bottom-left micro HUD corner tick
    Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: 4px;
        height: 2px;
        background: primary ? CyberTheme.accent_text : (touch.has-hover || active ? CyberTheme.accent : transparent);
    }

    // Active bottom-accent neon strip
    if (active && !primary) : Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: CyberTheme.accent;
    }

    // Content container (Supports icon children + text) - Full autolayer centering
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        padding-left: compact ? (root.text != "" ? 10px : 6px) : (root.text != "" ? 14px : 8px);
        padding-right: compact ? (root.text != "" ? 10px : 6px) : (root.text != "" ? 14px : 8px);
        padding-top: 0px;
        padding-bottom: 0px;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 6px;

        @children

        if (root.text != "") : Text {
            text: root.text;
            font-family: CyberTheme.font_mono;
            font-size: root.font_size;
            font-weight: (primary || active) ? 700 : 600;
            letter-spacing: 0.6px;
            color: root.icon_color;
            vertical-alignment: center;
            horizontal-alignment: center;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            animate color { duration: 100ms; }
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            root.clicked();
        }
    }
}
