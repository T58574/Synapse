import { CyberTheme } from "../theme.slint";
import { IconCheck, IconChevronDown } from "./icons.slint";

export struct SelectOption {
    id: string,
    text: string,
    badge: string,
}

export component CyberSelect inherits Rectangle {
    in property <string> prefix: "LOC";
    in property <string> current_text: "";
    in property <[SelectOption]> options: [];
    in-out property <int> current_index: 0;
    in property <bool> disabled: false;

    callback selected(int, string);

    height: 34px;
    min-width: 140px;
    background: CyberTheme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? CyberTheme.accent : CyberTheme.border;
    border-radius: CyberTheme.radius_sm;

    // Outer neon glow on hover
    if (touch.has-hover) : Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-width: 1px;
        border-color: CyberTheme.accent;
        opacity: 0.4;
        border-radius: CyberTheme.radius_sm;
    }

    // Corner chamfer notch
    Rectangle {
        x: parent.width - 5px;
        y: 0px;
        width: 5px;
        height: 5px;
        background: touch.has-hover ? CyberTheme.accent : CyberTheme.border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: "[" + root.prefix + "]";
                font-family: CyberTheme.font_mono;
                font-size: 11px;
                font-weight: 700;
                color: CyberTheme.accent;
                vertical-alignment: center;
            }

            Text {
                text: root.current_text != "" ? root.current_text :
                      (root.current_index >= 0 && root.current_index < root.options.length ? root.options[root.current_index].text : "--");
                font-family: CyberTheme.font_mono;
                font-size: 12px;
                font-weight: 600;
                color: CyberTheme.text;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        IconChevronDown {
            size: 12px;
            icon_color: touch.has-hover ? CyberTheme.accent : CyberTheme.muted;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 3px;
        width: Math.max(root.width, 220px);

        Rectangle {
            background: #0E131F;
            border-width: 1px;
            border-color: CyberTheme.accent;
            border-radius: CyberTheme.radius_sm;
            clip: true;

            // Outer glow line
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 2px;
                background: CyberTheme.accent;
            }

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Header
                Rectangle {
                    height: 20px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: space-between;
                        Text {
                            text: "// SELECT_PARAMETER";
                            font-family: CyberTheme.font_mono;
                            font-size: 9px;
                            color: CyberTheme.muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "SYS_PARAM";
                            font-family: CyberTheme.font_mono;
                            font-size: 9px;
                            color: CyberTheme.accent;
                            vertical-alignment: center;
                        }
                    }
                }

                // Options list
                for opt[idx] in root.options : Rectangle {
                    height: 28px;
                    background: item_touch.has-hover ? CyberTheme.active_row :
                                (idx == root.current_index ? CyberTheme.active_row : transparent);
                    border-radius: 1px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "[" + (idx < 9 ? "0" : "") + (idx + 1) + "]";
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                color: (idx == root.current_index || item_touch.has-hover) ? CyberTheme.accent : CyberTheme.muted;
                                vertical-alignment: center;
                            }

                            Text {
                                text: opt.text;
                                font-family: CyberTheme.font_mono;
                                font-size: 11px;
                                font-weight: idx == root.current_index ? 700 : 500;
                                color: idx == root.current_index ? CyberTheme.accent :
                                       item_touch.has-hover ? #FFFFFF : CyberTheme.text;
                                vertical-alignment: center;
                            }
                        }

                        if (idx == root.current_index) : HorizontalLayout {
                            spacing: 4px;
                            alignment: center;

                            IconCheck {
                                size: 10px;
                                icon_color: CyberTheme.accent;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "ACTIVE";
                                font-family: CyberTheme.font_mono;
                                font-size: 10px;
                                font-weight: 700;
                                color: CyberTheme.accent;
                                vertical-alignment: center;
                            }
                        }

                        if (idx != root.current_index && opt.badge != "") : Text {
                            text: opt.badge;
                            font-family: CyberTheme.font_mono;
                            font-size: 9px;
                            color: CyberTheme.muted;
                            vertical-alignment: center;
                        }
                    }

                    item_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current_index = idx;
                            root.selected(idx, opt.id);
                        }
                    }
                }
            }
        }
    }
}
