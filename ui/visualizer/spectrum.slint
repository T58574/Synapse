import { CyberTheme } from "../theme.slint";

export component SpectrumView inherits Rectangle {
    in property <[float]> magnitudes: [];
    in property <[float]> peaks: [];
    in property <bool> is_active: true;
    in property <length> bar_spacing: 1px;
    in property <length> min_bar_height: 2px;

    background: transparent;

    HorizontalLayout {
        spacing: root.bar_spacing;
        alignment: stretch;

        for mag[idx] in root.magnitudes : col := Rectangle {
            background: transparent;
            horizontal-stretch: 1;

            // Background subtle dark guide track
            Rectangle {
                width: 100%;
                height: 100%;
                background: #090E1744;
            }

            // 1. Smooth Rising & Falling Gradient Bar
            VerticalLayout {
                alignment: end;
                Rectangle {
                    height: root.is_active ? Math.max(root.min_bar_height, col.height * Math.min(1.0, Math.max(0.0, mag))) : root.min_bar_height;
                    background: @linear-gradient(180deg, #FF003C 0%, #FF8800 35%, #FCEE0A 70%, #00F0FF 100%);
                    border-radius: 1px;
                }
            }

            // 2. Winamp Falling Peak Particle ("падающая частичка")
            if (root.peaks.length > idx && root.peaks[idx] > 0.03) : Rectangle {
                width: 100%;
                height: 2px;
                y: Math.max(0px, (1.0 - Math.min(1.0, root.peaks[idx])) * (col.height - 2px));
                background: #FFFFFF;
                border-radius: 1px;
            }
        }
    }
}
